      ],
      "supersedes": null
    },
    {
      "decision_id": "decision:cinisello:virtual-semantic-separator",
      "status": "confirmed",
      "topic": "virtual_separator_construction",
      "assertion": "Per separare semanticamente gli ambienti attraversati da un passaggio si prolungano le linee murarie nella loro direzione e inclinazione fino alla prima intersezione con un'altra linea strutturale valida.",
      "scope_key": "page:301f9d08bbbeb162e0b893fe04cebd568b035f12829edb9cfcfa316f0b2fa9fc:1",
      "evidence": {
        "actor": "project_owner",
        "method": "explicit_confirmation"
      },
      "constraints": [
        "Testo, quote, arredi e simboli non arrestano il prolungamento.",
        "Il separatore è inferito, non è un muro fisico e non blocca il passaggio."
      ],
      "supersedes": null
    },
