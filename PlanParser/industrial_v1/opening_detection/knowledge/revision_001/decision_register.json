  "decisions": [
    {
      "decision_id": "decision:opening-symbols:variable-grammar",
      "status": "confirmed",
      "topic": "symbol_variability",
      "assertion": "Le rappresentazioni di porte e finestre cambiano spesso; non esiste un unico glifo universale.",
      "scope_key": "global:opening-symbols",
      "evidence": {
        "actor": "project_owner",
        "method": "explicit_confirmation"
      },
      "constraints": [
        "Il riconoscimento deve usare famiglie di evidenze e contesto murario, non un template unico."
      ],
      "supersedes": null
    },
    {
      "decision_id": "decision:door:perpendicular-line-at-wall-break",
      "status": "confirmed",
      "topic": "door_symbol_family",
      "assertion": "Una convenzione di porta è una linea isolata perpendicolare al muro nel punto in cui il muro è interrotto.",
      "scope_key": "global:opening-symbols",
      "evidence": {
        "actor": "project_owner",
        "method": "explicit_confirmation"
      },
      "constraints": [
        "Questa è una famiglia grafica, non l'unica rappresentazione possibile di una porta."
      ],
      "supersedes": null
    },
    {
      "decision_id": "decision:window:typically-embedded-in-wall",
      "status": "confirmed",
      "topic": "window_wall_relation",
      "assertion": "Di solito le finestre sono inserite dentro i muri e vengono segnalate in quella posizione.",
      "scope_key": "global:opening-symbols",
      "evidence": {
        "actor": "project_owner",
        "method": "explicit_confirmation"
      },
      "constraints": [
        "La relazione è frequente ma non universale; le eccezioni devono poter restare sconosciute."
      ],
      "supersedes": null
    },
    {
      "decision_id": "decision:portafinestra:context-dependent",
      "status": "confirmed",
      "topic": "window_vs_french_door",
      "assertion": "La classificazione come portafinestra dipende dal caso e non può essere assegnata automaticamente a ogni apertura ambigua.",
      "scope_key": "global:opening-symbols",
      "evidence": {
        "actor": "project_owner",
        "method": "explicit_confirmation"
      },
      "constraints": [
        "Portafinestra non viene silenziosamente normalizzata a finestra."
      ],
      "supersedes": null
    },
    {
      "decision_id": "decision:arba:doors-perpendicular-lines",
      "status": "confirmed",
      "topic": "door_example",
      "assertion": "Nella pagina di Arba le linee perpendicolari isolate nei varchi murari sono porte.",
