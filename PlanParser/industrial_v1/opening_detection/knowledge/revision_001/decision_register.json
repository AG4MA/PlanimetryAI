      ],
      "supersedes": null
    },
    {
      "decision_id": "decision:arba:windows-embedded-rectangles",
      "status": "confirmed",
      "topic": "window_example",
      "assertion": "Nella pagina di Arba i piccoli elementi rettangolari o lineari inseriti nel muro esterno sopra le due camere e la cucina sono finestre.",
      "scope_key": "page:10b5799141f8606e6b5f19fddef6ca3f49d0402f088ff25b887df89f7d65ab12:1",
      "evidence": {
        "actor": "project_owner",
        "method": "explicit_confirmation"
      },
      "constraints": [
